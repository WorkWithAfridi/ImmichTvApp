<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Both themes are dark so the launch window never flashes light before
         Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorPrimary">@color/immich_splash_background</item>
        <item name="android:navigationBarColor">@color/immich_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@color/immich_splash_background</item>
        <item name="android:colorPrimary">@color/immich_splash_background</item>
        <item name="android:navigationBarColor">@color/immich_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
    </style>
</resources>
