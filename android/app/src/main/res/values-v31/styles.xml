<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses the platform SplashScreen API; configure it to match
         the same dark window and centred brand mark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/immich_splash_background</item>
        <item name="android:colorPrimary">@color/immich_splash_background</item>
        <item name="android:navigationBarColor">@color/immich_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
    </style>
</resources>
